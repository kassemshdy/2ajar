# Copy to .env for local development. Never commit real secrets.
ENV=development
DATABASE_URL=postgresql+psycopg://ajar:ajar@localhost:5432/ajar_dev
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
PUBLIC_WEB_BASE_URL=http://localhost:3000
DEMO_MODE=true
LISTING_TTL_DAYS=30
PUBLISH_REQUIRES_MEDIA=true
STORAGE_BACKEND=local
MEDIA_ROOT=var/media
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=ajar-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://media.example.com
# Platform admin, created/updated by `python -m app.seed` (env is authoritative)
# SUPERUSER_EMAIL=admin@example.com
# SUPERUSER_PASSWORD=change-me-at-least-12-chars
# Seed: password for demo accounts (dev/staging only). Leave unset for unusable random passwords.
# SEED_DEMO_PASSWORD=
